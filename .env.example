# Copy to .env (make env-file does this). Never commit the real .env.
MYSQL_ROOT_PASSWORD=root_pass_change_me
MYSQL_DATABASE=telecomdb
MYSQL_USER=telecom_user
MYSQL_PASSWORD=telecom_pass_change_me

APP_PORT=8080
DB_POOL_SIZE=10
# Multipart limits can be overridden per environment
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=20MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=60MB
TELECOM_STORAGE_MAX_STREAM_SIZE=200MB
